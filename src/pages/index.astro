---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/ui/Marquee.astro';
import Arrow from '../components/ui/Arrow.astro';
import WorkIndex from '../components/sections/WorkIndex.astro';
import Gallery from '../components/gallery/Gallery.astro';
import { site, places, awardsMarquee, featuredQuotes } from '../data/site';
import { juryAndStage } from '../data/gallery';
import hero from '../assets/images/hero-portrait.jpg';
import { Image } from 'astro:assets';
import workshop from '../assets/images/workshop.jpg';
---

<Base title={site.name} path="/">
  <!-- ============ Hero ============ -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <figure class="hero__figure">
      <Picture
        src={hero}
        formats={['avif', 'webp']}
        widths={[420, 640, 860, 1215]}
        sizes="(max-width: 899px) 92vw, 600px"
        alt="Ruchi Sharma in black and white, smiling, with her hand resting under her chin"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="hero__curtain" data-hero-curtain></span>
    </figure>

    <div class="hero__type">
      <h1 id="hero-title" class="hero__title">
        <span><b>Ruchi</b></span>
        <span><b>Sharma</b></span>
      </h1>
    </div>

    <div class="hero__mask" data-hero-mask aria-hidden="true">
      <div class="hero__type">
        <p class="hero__mask-title">
          <span><b>Creative</b></span>
          <span><b>Director</b></span>
        </p>
      </div>
    </div>

    <div class="hero__meta">
      <p class="hero__roles">
        {site.roles.map((r) => <span>{r}</span>)}
      </p>
      <p class="hero__tag">{site.tagline}</p>
    </div>

    <a class="hero__scroll" href="#intro" aria-label="Scroll to introduction">
      <span>Scroll</span><i aria-hidden="true"></i>
    </a>
  </section>

  <Marquee items={awardsMarquee} label="Recognised by" speed={55} />

  <!-- ============ Intro ============ -->
  <section class="section" id="intro">
    <div class="wrap split">
      <div class="split__a">
        <p class="eyebrow" data-fade>01 — About</p>
      </div>
      <div class="split__b split__b--wide">
        <p class="statement statement--wide" data-lit>
          Ruchi Sharma is an awarded Writer and Creative Director, adept at brand storytelling that builds emotional
          connections in a human-centric world.
        </p>
        <p class="lead muted" data-fade style="max-width:46ch;margin-top:clamp(28px,4vw,60px)">
          She has grown and repositioned her clients’ businesses in {places.slice(0, -1).join(', ')} and {places.at(-1)},
          holding leadership roles in most large agency networks.
        </p>
        <p data-fade><a class="btn" href="/about/">About Ruchi <Arrow /></a></p>
      </div>
    </div>
  </section>

  <!-- ============ Editorial image (natural ratio: nobody gets cropped out) ============ -->
  <section class="wrap split split--flip" style="padding-bottom:var(--section)" aria-label="Ruchi speaking">
    <div class="split__a" style="align-self:end">
      <p class="eyebrow">Speaker &amp; mentor</p>
      <p class="lead muted" data-fade style="max-width:24ch">
        Ruchi is a staunch supporter of DEI values and has spoken on ethics, collaboration and equality.
      </p>
    </div>
    <figure class="split__b split__fig" style="margin:0">
      <div class="frame" data-mask data-parallax-img style="aspect-ratio:1478/1108">
        <Image
          src={workshop}
          alt="Ruchi Sharma presenting to a seated audience at a conference session"
          widths={[640, 1000, 1478]}
          sizes="(min-width: 900px) 56vw, 92vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="caption"><span>Speaking</span></figcaption>
    </figure>
  </section>

  <!-- ============ Work ============ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">02 — Work</p>
      <div style="display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:24px;margin-bottom:clamp(36px,5vw,80px)">
        <h2 class="display-lg" data-split>Brands &amp;<br />causes</h2>
        <a class="btn" href="/work/">All work <Arrow /></a>
      </div>
      <WorkIndex limit={6} />
    </div>
  </section>

  <!-- ============ Jury & stage ============ -->
  <section class="section border-top">
    <div class="wrap">
      <p class="eyebrow">03 — Jury &amp; stage</p>
      <h2 class="display-lg" data-split style="margin-bottom:clamp(36px,5vw,80px)">
        Judging the<br />world’s best
      </h2>
      <Gallery items={[0, 1, 2, 4].map((i) => juryAndStage[i]!)} cols={2} />
      <p style="margin-top:28px"><a class="btn" href="/resume/">Full jury record <Arrow /></a></p>
    </div>
  </section>

  <!-- ============ Words from colleagues ============ -->
  <section class="section border-top">
    <div class="wrap">
      <p class="eyebrow">04 — Kind words</p>
      <div class="quotes quotes--3">
        {
          featuredQuotes.map((q) => (
            <figure class="quote" data-fade>
              <blockquote>
                <p class="quote__text">{q.text}</p>
              </blockquote>
              <footer>
                {q.who}
                <span>{q.role}</span>
              </footer>
            </figure>
          ))
        }
      </div>
      <p style="margin-top:clamp(36px,5vw,70px)"><a class="link" href="/resume/#recommendations">Read all recommendations →</a></p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section border-top">
    <div class="wrap">
      <p class="eyebrow">05 — Contact</p>
      <a class="contact-big" href="/contact/" data-fade>
        <span>Let’s</span> <span>talk</span> →
      </a>
    </div>
  </section>
</Base>
