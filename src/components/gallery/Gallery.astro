---
import { Image } from 'astro:assets';
import type { GalleryItem } from '../../data/gallery';

interface Props {
  items: GalleryItem[];
  cols?: 2 | 3;
}
const { items, cols = 3 } = Astro.props;
---

<div class:list={['gallery', { 'gallery--2': cols === 2 }]}>
  {
    items.map((it) => (
      <figure class="gallery__item" data-mask>
        <Image
          src={it.src}
          alt={it.alt}
          widths={[420, 640, 900]}
          sizes={cols === 2 ? '(min-width:640px) 46vw, 92vw' : '(min-width:1100px) 30vw, (min-width:640px) 46vw, 92vw'}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{it.caption}</figcaption>
      </figure>
    ))
  }
</div>
