---
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  path?: string;
  jsonLd?: Record<string, unknown>[];
  noFooter?: boolean;
}

const { title, description = site.description, image = '/og.jpg', path, jsonLd = [] } = Astro.props;
const pathname = path ?? Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title === site.name ? `${site.name} — Writer, Creative Director, Speaker, Mentor` : `${title} — ${site.name}`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Writer and Creative Director',
  description: site.description,
  email: site.email,
  telephone: site.phone,
  image: new URL('/og.jpg', site.url).href,
  sameAs: site.socials.map((s) => s.href),
  worksFor: { '@type': 'Organization', name: 'HumanSense', location: 'Colombo, Sri Lanka' },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ruchi Sharma, Writer and Creative Director" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Theme + JS flag set before first paint to avoid flashes. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
        // Failsafe: if the motion bundle never boots, reveal everything.
        window.__motionFailsafe = setTimeout(function () {
          d.classList.add('no-anim');
        }, 4500);
      })();
    </script>

    {[person, ...jsonLd].map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!Astro.props.noFooter && <Footer />}
    <script>
      import '../lib/motion';
    </script>
  </body>
</html>
